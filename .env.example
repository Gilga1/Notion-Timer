# Get this from https://www.notion.so/my-integrations
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Notion data source / database IDs (no spaces around =)
PROJECTS_DS=your-projects-database-id-here
TASKS_DS=your-tasks-database-id-here
HABITS_DS=your-habits-database-id-here
MEALS_DS=your-meals-database-id-here
# Optional local nutrition DS (JSON meals sync). Prefer MEALS_DS for Notion meals.
# NUTRITION_DS=

# Optional API key — when set, mutating routes require header: x-api-key
# APP_API_KEY=
# VITE_APP_API_KEY=

# Daily calorie target (default 2150)
# MAINTENANCE_CALORIES=2150

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Tavily web search for richer reward suggestions
TAVILY_API_KEY=
TAVILY_ENDPOINT=https://api.tavily.com/search

# Push notifications (Web Push / VAPID)
# Generate once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Public base URL (needed for push + NFC links)
BASE_URL=http://localhost:5000

# Optional JSON DB paths (defaults are project-root files)
# SESSION_DB_PATH=
# REWARDS_DB_PATH=
# MEALS_DB_PATH=
# PUSH_SUBS_PATH=

PORT=5000
